root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
tab_width = 4
ij_continuation_indent_size = 8
ij_smart_tabs = false
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2
