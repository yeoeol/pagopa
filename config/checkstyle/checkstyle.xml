<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <!-- Every source file must end with a newline. -->
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- Naming conventions -->
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="${methodNameFormat}"/>
        </module>
        <module name="MemberName"/>
        <module name="ConstantName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Imports and source-file structure -->
        <module name="UnusedImports"/>
        <module name="OuterTypeFilename"/>

        <!-- Do not depend on JDK-internal APIs. -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun,com.sun,jdk.internal"/>
        </module>

        <!-- Spring applications should use a logger instead of standard output. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print(ln|f)?\s*\("/>
            <property name="message" value="Use the application logger instead of System.out/System.err."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
